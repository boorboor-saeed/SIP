
/control/verbose 2
/run/verbose 2
#

/Material/DefineElement Ag 79 196.977
/Material/DefineMaterial Gold 19.3 1
/Material/AddElementByNumber Gold Ag 1

/Material/DefineElement Si 14 28.0855
/Material/DefineMaterial Silicon 2.7 1
/Material/AddElementByNumber Silicon Si 1


/run/initialize

/Geometry/CreateDetector 5 10e-6 10e-6 0.5 Gold Silicon Silicon





#
/run/setCut 1 nm
#
/gun/particle alpha
#/gun/particle ion
#/gun/ion 6 12 6

/gun/position 0 0 -1 um
/gun/direction 0 0 1
/gun/energy 5.5 MeV

#/tracking/verbose 3
/run/beamOn 100

